{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/mcp/**/*.ts",
    "../src/lib/diff.ts",
    "../src/lib/plugins.ts",
    "../src/lib/site-url.ts",
    "../src/lib/types.ts",
    "../src/lib/tokens.ts"
  ]
}
